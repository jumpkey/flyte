<div class="container py-4">
  <div class="panel checkout-panel text-center">
    <div class="success-mark mb-3">✓</div>
    <h1 class="h3 mb-1">You're registered!</h1>
    <p class="text-muted mb-4">A receipt is on its way to <strong><%= registration.email %></strong></p>

    <div class="receipt text-start mb-4">
      <% if (event) { %>
      <div class="row-line"><span class="k">Event</span><span class="v"><%= event.name %></span></div>
      <div class="row-line"><span class="k">When</span><span class="v"><%= new Date(event.event_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></span></div>
      <% if (event.location) { %>
      <div class="row-line"><span class="k">Where</span><span class="v"><%= event.location %></span></div>
      <% } %>
      <% } %>
      <div class="row-line"><span class="k">Name</span><span class="v"><%= registration.firstName %> <%= registration.lastName %></span></div>
      <div class="row-line"><span class="k">Amount paid</span><span class="v money"><%= money(registration.grossAmountCents) %></span></div>
      <div class="row-line"><span class="k">Registration ID</span><span class="v" style="font-size:.8rem;"><%= registration.registrationId %></span></div>
      <div class="row-line"><span class="k">Status</span><span class="v"><%- include('partials/status-pill', { status: registration.status }) %></span></div>
    </div>

    <%# Activation callout (WF-05 / J3) — accent *tint*, an invitation not the page's
        primary action. Shown only when the buyer's account is still a shadow. %>
    <% if (typeof isShadow !== 'undefined' && isShadow) { %>
    <div class="alert mb-3 text-start" style="background: var(--fl-flare-tint); border:0;">
      <strong>Save your registration history.</strong>
      Activate a free account to see this and future registrations in one place — just set a password.
      <div class="mt-2">
        <a class="btn btn-outline-secondary btn-sm" href="/forgot-password?email=<%= encodeURIComponent(ownerEmail) %>">Activate your account</a>
      </div>
    </div>
    <% } %>

    <p class="text-muted" style="font-size:.9rem;">Plans changed? You can request a refund any time before the event.</p>
    <div class="d-flex gap-2 justify-content-center flex-wrap">
      <a href="/registration/<%= registration.registrationId %>/calendar.ics" class="btn btn-outline-secondary">Add to calendar</a>
      <a href="/registration/<%= registration.registrationId %>/refund-request" class="btn btn-outline-secondary">Request a refund</a>
      <a href="/events" class="btn btn-outline-secondary">Browse more events</a>
    </div>
  </div>
</div>
