<div class="container py-4">
  <div class="panel checkout-panel text-center">
    <h1 class="h3 mb-3">Finalizing your registration…</h1>
    <p class="text-muted"><% if (registration && registration.status === 'PENDING_PAYMENT') { %>Your payment is still being verified. Your registration is not confirmed yet.<% } else { %>Your payment was authorized and we're securing your spot. Your registration is not confirmed yet; refresh this page to check for finalization.<% } %></p>
    <p class="text-muted" style="font-size:.9rem;">Please keep this page or your registration link. If the status does not change, contact support with your payment reference.</p>
    <a href="/registration/<%= registration.registrationId %>/confirmed" class="btn btn-cta mt-3">Check registration status</a>
    <a href="/" class="btn btn-outline-secondary mt-3">Return home</a>
  </div>
</div>
