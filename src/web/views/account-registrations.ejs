<div class="container py-4">
  <h1 class="h3 mb-4">My registrations</h1>

  <% if ((!registrations || registrations.length === 0) && (!waitlist || waitlist.length === 0)) { %>
    <%- include('partials/empty-state', { title: 'No registrations yet', message: 'When you book an event it shows up here — including anything you bought as a guest.', ctaHref: '/events', ctaLabel: 'Browse events' }) %>
  <% } else { %>

    <% if (registrations && registrations.length > 0) { %>
    <h2 class="h5 mb-2">Registrations</h2>
    <div class="table-responsive mb-4">
      <table class="table table-roomy align-middle">
        <thead><tr><th>Event</th><th>When</th><th>Status</th><th class="text-end">Amount</th><th></th></tr></thead>
        <tbody>
          <% registrations.forEach(function (r) { %>
          <tr>
            <td><a class="text-decoration-none fw-semibold" href="/account/registrations/<%= r.registration_id %>"><%= r.event_name %></a></td>
            <td><%= dateLong(r.event_date) %></td>
            <td><%- include('partials/status-pill', { status: displayStatus({ status: r.status, refunded_amount_cents: r.refunded_amount_cents }) }) %></td>
            <td class="text-end money"><%= money(r.gross_amount_cents) %></td>
            <td class="text-end">
              <span class="d-inline-flex flex-wrap justify-content-end gap-3">
                <a class="text-decoration-none" href="/account/registrations/<%= r.registration_id %>">View →</a>
                <% if (r.can_request_refund) { %>
                <a class="text-decoration-none" href="/registration/<%= r.registration_id %>/refund-request">Request a refund →</a>
                <% } %>
              </span>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>

    <% if (waitlist && waitlist.length > 0) { %>
    <h2 class="h5 mb-2">Waitlists</h2>
    <div class="table-responsive">
      <table class="table table-roomy align-middle">
        <thead><tr><th>Event</th><th>When</th><th>Position</th><th></th></tr></thead>
        <tbody>
          <% waitlist.forEach(function (w) { %>
          <tr>
            <td><a class="text-decoration-none fw-semibold" href="/events/<%= w.event_id %>"><%= w.event_name %></a></td>
            <td><%= dateLong(w.event_date) %></td>
            <td>#<%= w.position %></td>
            <td class="text-end">
              <a class="text-decoration-none" href="/waitlist/<%= w.waitlist_entry_id %>">View →</a>
              <span class="text-muted">·</span>
              <form method="post" action="/account/waitlist/<%= w.waitlist_entry_id %>/remove" class="d-inline"
                    onsubmit="return confirm('Remove yourself from this waitlist?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-link btn-sm text-decoration-none p-0 text-danger">Remove</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>

  <% } %>
</div>
