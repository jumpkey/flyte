<section class="hero">
  <div class="container">
    <h1 class="display-5">Find your next event</h1>
    <p class="lead">Workshops, meetups and community events — secure checkout in under a minute. No account needed.</p>
    <a href="/events" class="btn btn-cta mt-3">Browse all events</a>
  </div>
</section>

<section id="events" class="container py-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <h2 class="h3 mb-0">Upcoming events</h2>
    <a href="/events" class="text-decoration-none fw-semibold">See all →</a>
  </div>
  <% if (!events || events.length === 0) { %>
    <%- include('partials/empty-state', { title: 'No upcoming events yet', message: 'Check back soon — new events are added regularly.' }) %>
  <% } else { %>
    <div class="row g-4">
      <% events.forEach(function (ev) { %>
        <div class="col-12 col-md-6 col-lg-4">
          <%- include('partials/event-card', { ev: ev }) %>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>
