<div class="container">
  <div class="panel auth-panel">
    <h1 class="h3 mb-1">Create your account</h1>
    <p class="text-muted mb-4">Your events and receipts, all in one place</p>

    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <div class="alert alert-flyte alert-flyte-error" role="alert">
      <% errors.forEach(function(err) { %><p class="m-0"><%= err %></p><% }); %>
    </div>
    <% } %>

    <form action="/register" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" required autocomplete="email"
          value="<%= typeof formData !== 'undefined' && formData ? formData.email : '' %>"
          hx-post="/api/check-email"
          hx-trigger="blur changed delay:500ms"
          hx-target="#email-feedback"
          hx-swap="innerHTML"
          hx-include="[name='email']">
        <div id="email-feedback" class="form-text"></div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="displayName">Display name</label>
        <input class="form-control" type="text" id="displayName" name="displayName" required autocomplete="name"
          value="<%= typeof formData !== 'undefined' && formData ? formData.displayName : '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" type="password" id="password" name="password" required autocomplete="new-password" minlength="8">
      </div>
      <div class="mb-3">
        <label class="form-label" for="confirmPassword">Confirm password</label>
        <input class="form-control" type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" minlength="8">
      </div>
      <button type="submit" class="btn btn-primary w-100">Create account</button>
    </form>

    <p class="mt-4 text-center text-muted mb-0">Already have an account? <a href="/login">Sign in</a></p>
  </div>
</div>
