<div class="container">
  <div class="panel auth-panel text-center">
    <div class="success-mark mb-3">✓</div>
    <h1 class="h3 mb-2">Check your email</h1>
    <p class="text-muted">We sent a verification link to <strong><%= typeof email !== 'undefined' ? email : '' %></strong>. Click it to activate your account — it expires in 24 hours.</p>
    <p class="mt-4 mb-0"><a href="/login">Back to sign in</a></p>
  </div>
</div>
