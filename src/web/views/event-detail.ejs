<section class="container py-4 py-lg-5">
  <a class="text-decoration-none small text-secondary" href="/events">← All events</a>

  <div class="row g-4 g-lg-5 mt-1">
    <%# Left: persuade — image + description %>
    <div class="col-12 col-lg-7">
      <div class="event-media event-media-detail rounded mb-4">
        <div class="event-fallback">
          <span class="initials"><%= eventInitials(event.name) %></span>
          <span class="when"><%= dateBadge(event.event_date) %></span>
        </div>
        <% if (event.image_url) { %>
          <img src="<%= event.image_url %>" alt="">
        <% } %>
      </div>
      <h1 class="h3"><%= event.name %></h1>
      <p class="event-meta text-secondary">
        <%= dateLong(event.event_date) %><% if (event.location) { %> · <%= event.location %>
          <a class="text-decoration-none ms-1" target="_blank" rel="noopener"
             href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(event.location) %>">Map ↗</a>
        <% } %>
      </p>
      <% if (event.description) { %>
        <div class="mt-3"><%= event.description %></div>
      <% } %>
    </div>

    <%# Right: convert — price, availability, CTA cluster %>
    <div class="col-12 col-lg-5">
      <div class="panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="event-price money fs-3"><%= money(event.registration_fee_cents) %></span>
          <%- include('partials/status-pill', { status: event.status }) %>
        </div>

        <% if (alreadyRegistered) { %>
          <div class="alert alert-flyte mb-3" role="status"><strong>You're registered ✓</strong></div>
          <a class="btn btn-outline-secondary w-100" href="/dashboard">View your account</a>

        <% } else if (event.status === 'CLOSED') { %>
          <p class="text-secondary mb-3">Registration for this event is closed.</p>
          <button class="btn btn-secondary w-100" disabled>Registration closed</button>

        <% } else if (card.soldOut) { %>
          <% if (card.waitlistOpen) { %>
            <p class="mb-3 fw-semibold" style="color: var(--fl-info-text);">This event is sold out.</p>
            <a class="btn btn-primary w-100" href="/events/<%= event.event_id %>/waitlist">Join the waitlist</a>
            <p class="text-secondary small mt-2 mb-0">We'll email you if a spot opens up.</p>
          <% } else { %>
            <p class="text-secondary mb-3">This event is sold out and the waitlist is closed.</p>
            <button class="btn btn-secondary w-100" disabled>Sold out</button>
          <% } %>

        <% } else { %>
          <div class="meter <%= card.state === 'low' ? 'meter-low' : '' %> mb-1">
            <div class="meter-fill" style="width: <%= card.meterPct %>%"></div>
          </div>
          <div class="meter-label <%= card.state === 'low' ? 'low' : '' %> mb-3"><%= event.available_slots %> of <%= event.total_capacity %> spots left</div>
          <a class="btn btn-cta w-100" href="/events/<%= event.event_id %>/register">Register — <%= money(event.registration_fee_cents) %></a>
          <p class="text-secondary small mt-2 mb-0">No account needed — check out as a guest.</p>
        <% } %>
        <%# Refund-policy excerpt (V6) — full policy on /terms. %>
        <p class="text-secondary small mt-3 mb-0">Refundable until the event — <a class="text-decoration-none" href="/terms">see policy</a>.</p>
      </div>
    </div>
  </div>
</section>
