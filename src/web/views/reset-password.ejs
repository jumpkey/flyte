<div class="container">
  <div class="panel auth-panel">
    <h1 class="h3 mb-4">Reset password</h1>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-flyte alert-flyte-error" role="alert"><%= error %></div>
    <% } %>
    <form action="/reset-password" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">
      <div class="mb-3">
        <label class="form-label" for="password">New password</label>
        <input class="form-control" type="password" id="password" name="password" required autocomplete="new-password" minlength="8">
      </div>
      <div class="mb-3">
        <label class="form-label" for="confirmPassword">Confirm new password</label>
        <input class="form-control" type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" minlength="8">
      </div>
      <button type="submit" class="btn btn-primary w-100">Reset password</button>
    </form>
  </div>
</div>
