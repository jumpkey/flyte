<div class="container py-4">
  <div class="panel checkout-panel">
    <div class="stepper" id="checkout-stepper">
      <span class="step active" data-step="1"><span class="dot">1</span> Details</span>
      <span class="rail"></span>
      <span class="step" data-step="2"><span class="dot">2</span> Payment</span>
    </div>

    <div class="order-summary mb-4">
      <div class="d-flex justify-content-between">
        <span><strong><%= event.name %></strong> — <%= new Date(event.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% if (event.location) { %> · <%= event.location %><% } %></span>
      </div>
      <div class="d-flex justify-content-between mt-1">
        <span class="text-muted"><%= event.availability.availableSlots %> spots left · Total due today</span>
        <span class="total money">$<%= (event.registration_fee_cents / 100).toFixed(2) %></span>
      </div>
    </div>

    <div id="registration-step-1">
      <div id="form-error" class="alert alert-flyte alert-flyte-error" style="display:none;" role="alert"></div>
      <%# Logged-in: split the account display name into First/Last as editable
          defaults (mirrors the prefilled email below). Guest: empty. %>
      <% var _nameParts = (user ? (user.displayName || '').trim() : '').split(/\s+/).filter(Boolean);
         var _firstName = _nameParts.length ? _nameParts[0] : '';
         var _lastName = _nameParts.length > 1 ? _nameParts.slice(1).join(' ') : ''; %>
      <form id="participant-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3 mb-3">
          <div class="col-12 col-sm-6">
            <label class="form-label" for="firstName">First name</label>
            <input class="form-control" type="text" id="firstName" name="firstName" value="<%= _firstName %>" required>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label" for="lastName">Last name</label>
            <input class="form-control" type="text" id="lastName" name="lastName" value="<%= _lastName %>" required>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="email">Email</label>
          <%# Logged-in: email prefilled + locked, no confirm field (session wins,
              AC-I3 ③). Guest: confirm-email double-entry (D1). %>
          <input class="form-control" type="email" id="email" name="email" required
                 value="<%= user ? user.email : '' %>"<%= user ? ' readonly' : '' %>>
        </div>
        <% if (!user) { %>
        <div class="mb-3">
          <label class="form-label" for="emailConfirm">Confirm email</label>
          <input class="form-control" type="email" id="emailConfirm" name="emailConfirm" required autocomplete="off">
          <div class="text-danger small mt-1" id="email-mismatch" style="display:none;">The email addresses do not match.</div>
          <div class="form-text">We email your receipt and any refund here — no account needed.</div>
        </div>
        <% } %>
        <div class="mb-4">
          <label class="form-label" for="phone">Phone (optional)</label>
          <input class="form-control" type="tel" id="phone" name="phone">
        </div>
        <button type="submit" id="continue-btn" class="btn btn-cta w-100">Continue to payment</button>
      </form>
      <p class="text-center text-muted mt-3 mb-0" style="font-size: .85rem;">🔒 Secure checkout<%= user ? '' : ' · No account needed' %></p>
    </div>

    <div id="registration-step-2" style="display:none;">
      <div id="payment-element-container" class="mb-3"></div>
      <div id="payment-error" class="alert alert-flyte alert-flyte-error" style="display:none;" role="alert"></div>
      <button id="pay-btn" disabled class="btn btn-cta w-100 mb-2">Pay $<%= (event.registration_fee_cents / 100).toFixed(2) %></button>
      <button id="back-btn" type="button" class="btn btn-outline-secondary w-100">Back</button>
      <p class="text-center text-muted mt-3 mb-0" style="font-size: .85rem;">Your spot is held while you pay. Payments processed by Stripe.</p>
    </div>

    <div id="registration-loading" style="display:none;" class="text-center py-4">
      <p class="text-muted mb-0">Processing your registration…</p>
    </div>
  </div>
</div>

<div data-stripe-key="<%= stripePublishableKey %>"></div>
<script src="https://js.stripe.com/v3/"></script>
<script src="/public/js/registration-form.js"></script>
