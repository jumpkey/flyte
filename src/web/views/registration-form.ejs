<div>
  <h1>Register: <%= event.name %></h1>

  <p>
    <strong>Date:</strong> <%= new Date(event.event_date).toLocaleDateString() %><br>
    <% if (event.location) { %><strong>Location:</strong> <%= event.location %><br><% } %>
    <strong>Spots Available:</strong> <%= event.availability.availableSlots %><br>
    <strong>Registration Fee:</strong> $<%= (event.registration_fee_cents / 100).toFixed(2) %>
  </p>

  <div id="registration-step-1">
    <h2>Your Information</h2>
    <form id="participant-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label for="firstName">First Name</label>
        <input type="text" id="firstName" name="firstName" required>
      </div>
      <div>
        <label for="lastName">Last Name</label>
        <input type="text" id="lastName" name="lastName" required>
      </div>
      <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div>
        <label for="phone">Phone (optional)</label>
        <input type="tel" id="phone" name="phone">
      </div>
      <button type="submit" id="continue-btn">Continue to Payment</button>
    </form>
  </div>

  <div id="registration-step-2" style="display:none;">
    <h2>Payment</h2>
    <div id="payment-element-container"></div>
    <div id="payment-error" style="color:red; display:none;"></div>
    <button id="pay-btn" disabled>Pay $<%= (event.registration_fee_cents / 100).toFixed(2) %></button>
    <button id="back-btn" type="button">Back</button>
  </div>

  <div id="registration-loading" style="display:none;">
    <p>Processing your registration...</p>
  </div>
</div>

<div data-stripe-key="<%= stripePublishableKey %>"></div>

<script src="https://js.stripe.com/v3/"></script>
<script src="/public/js/registration-form.js"></script>
