<div class="container py-4">
  <div class="panel checkout-panel">
    <h1 class="h3 mb-4">Edit profile</h1>
    <div id="profile-feedback"></div>
    <form hx-post="/profile" hx-target="#profile-feedback" hx-swap="innerHTML">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="caption-label">Account info</p>
      <div class="mb-3">
        <label class="form-label" for="email">Email (read-only)</label>
        <input class="form-control" type="email" id="email" value="<%= typeof user !== 'undefined' && user ? user.email : '' %>" disabled>
      </div>
      <div class="mb-4">
        <label class="form-label" for="displayName">Display name</label>
        <input class="form-control" type="text" id="displayName" name="displayName"
          value="<%= typeof user !== 'undefined' && user ? user.displayName : '' %>" required minlength="2">
      </div>
      <p class="caption-label">Change password (optional)</p>
      <div class="mb-3">
        <label class="form-label" for="currentPassword">Current password</label>
        <input class="form-control" type="password" id="currentPassword" name="currentPassword" autocomplete="current-password">
      </div>
      <div class="mb-3">
        <label class="form-label" for="newPassword">New password</label>
        <input class="form-control" type="password" id="newPassword" name="newPassword" autocomplete="new-password" minlength="8">
      </div>
      <div class="mb-4">
        <label class="form-label" for="confirmPassword">Confirm new password</label>
        <input class="form-control" type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" minlength="8">
      </div>
      <button type="submit" class="btn btn-primary">Save changes</button>
      <a href="/dashboard" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
