<%# Swappable refund table + pagination (HTMX target #refund-queue).
    Locals: rows, tab, page, totalPages, total.
    - open:     the customer-request queue (approve/deny; B5 dialogs).
    - resolved: the refund ledger — every executed refund from refund_log,
                including direct admin refunds with no originating request. %>
<%
  function pageUrl(p) {
    var q = new URLSearchParams();
    if (tab === 'resolved') q.set('tab', 'resolved');
    q.set('page', String(p));
    return '/admin/refund-requests?' + q.toString();
  }
  var noun = tab === 'resolved' ? 'refund' : 'request';
%>
<p class="text-secondary small mb-2"><%= total %> <%= noun %><%= total === 1 ? '' : 's' %></p>
<% if (!rows || rows.length === 0) { %>
  <%- include('../../partials/empty-state', {
        title: tab === 'open' ? 'No pending requests' : 'No refunds yet',
        message: tab === 'open'
          ? 'When a customer files a refund request it appears here.'
          : 'Every refund — whether from an approved request or a direct admin refund — appears here.' }) %>
<% } else if (tab === 'resolved') { %>
<div class="table-responsive">
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Customer</th>
        <th>Event</th>
        <th class="text-end">Refunded</th>
        <th>Type</th>
        <th>Origin</th>
        <th class="text-end">Date</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function (fl) {
           var fromRequest = fl.from_request === true || fl.reason === 'refund_request_approved';
      %>
      <tr>
        <td>
          <a class="fw-semibold text-decoration-none" href="/admin/registrations/<%= fl.registration_id %>"><%= fl.first_name %> <%= fl.last_name %></a>
          <div class="text-secondary small"><%= fl.email %></div>
        </td>
        <td><%= fl.event_name %></td>
        <td class="text-end money"><%= money(fl.amount_cents) %></td>
        <td class="small text-uppercase text-secondary"><%= fl.refund_type %></td>
        <td class="small"><%= fromRequest ? 'Customer request' : 'Direct refund' %></td>
        <td class="text-end small"><%= dateLong(fl.created_at) %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="table-responsive">
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Customer</th>
        <th>Event</th>
        <th>Requested</th>
        <th class="text-end">Refundable</th>
        <th>Reason</th>
        <th class="text-end">Action</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function (rq) {
           var net = (rq.net_amount_cents != null) ? rq.net_amount_cents : rq.gross_amount_cents;
           var remaining = net - rq.refunded_amount_cents;
      %>
      <tr>
        <td>
          <a class="fw-semibold text-decoration-none" href="/admin/registrations/<%= rq.registration_id %>"><%= rq.first_name %> <%= rq.last_name %></a>
          <div class="text-secondary small"><%= rq.email %></div>
        </td>
        <td><%= rq.event_name %></td>
        <td class="small"><%= dateLong(rq.requested_at) %></td>
        <td class="text-end money"><%= money(remaining) %></td>
        <td class="small"><%= rq.reason ? rq.reason : '—' %></td>
        <td class="text-end">
          <div class="d-flex gap-2 justify-content-end">
            <button class="btn btn-primary btn-sm" data-open-dialog="#approve-<%= rq.request_id %>">Approve &amp; refund</button>
            <button class="btn btn-outline-danger btn-sm" data-open-dialog="#deny-<%= rq.request_id %>">Deny</button>
          </div>

          <dialog id="approve-<%= rq.request_id %>" class="flyte-dialog">
            <form method="post" action="/admin/refund-requests/<%= rq.request_id %>/approve" data-once>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <h2 class="h5">Approve refund</h2>
              <p class="text-secondary small mb-2">Refunds to <%= rq.first_name %> <%= rq.last_name %> and cancels the registration. Lower the amount to keep a service fee.</p>
              <label class="form-label" for="amount-<%= rq.request_id %>">Refund amount</label>
              <div class="input-group mb-1" style="max-width: 12rem;">
                <span class="input-group-text">$</span>
                <input class="form-control" id="amount-<%= rq.request_id %>" name="amount" inputmode="decimal" value="<%= (remaining / 100).toFixed(2) %>">
              </div>
              <div class="form-text mb-3">Up to <span class="money"><%= money(remaining) %></span> — never more than the amount charged.</div>
              <div class="mb-3">
                <label class="form-label" for="approve-note-<%= rq.request_id %>">Note <span class="text-secondary">(optional)</span></label>
                <textarea class="form-control" id="approve-note-<%= rq.request_id %>" name="note" rows="2" maxlength="500"></textarea>
              </div>
              <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-close-dialog>Cancel</button>
                <button type="submit" class="btn btn-primary" data-busy="Refunding…">Approve &amp; refund</button>
              </div>
            </form>
          </dialog>

          <dialog id="deny-<%= rq.request_id %>" class="flyte-dialog">
            <form method="post" action="/admin/refund-requests/<%= rq.request_id %>/deny">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <h2 class="h5">Deny refund request</h2>
              <p class="text-secondary small">The note is emailed to the customer.</p>
              <div class="mb-3">
                <label class="form-label" for="note-<%= rq.request_id %>">Note <span class="text-danger">*</span></label>
                <textarea class="form-control" id="note-<%= rq.request_id %>" name="note" rows="3" required maxlength="500"></textarea>
              </div>
              <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-close-dialog>Cancel</button>
                <button type="submit" class="btn btn-danger">Deny &amp; notify</button>
              </div>
            </form>
          </dialog>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

<% if (rows && rows.length > 0 && totalPages > 1) { %>
<nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Refund pages">
  <% if (page > 1) { %>
    <a class="btn btn-outline-secondary btn-sm" href="<%= pageUrl(page - 1) %>" hx-get="<%= pageUrl(page - 1) %>" hx-target="#refund-queue" hx-swap="innerHTML" hx-push-url="true">← Previous</a>
  <% } else { %><span class="btn btn-outline-secondary btn-sm disabled">← Previous</span><% } %>
  <span class="text-secondary small">Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
    <a class="btn btn-outline-secondary btn-sm" href="<%= pageUrl(page + 1) %>" hx-get="<%= pageUrl(page + 1) %>" hx-target="#refund-queue" hx-swap="innerHTML" hx-push-url="true">Next →</a>
  <% } else { %><span class="btn btn-outline-secondary btn-sm disabled">Next →</span><% } %>
</nav>
<% } %>
