<%# A1 dashboard body (HTMX-swappable on range change). Charts are garnish — the
    numbers are always in text too (WK-A11Y-3). %>
<div class="row g-3 mb-4">
  <% function kpi(label, value, sub) { %>
    <div class="col-6 col-lg-3"><div class="panel py-2">
      <div class="caption-label"><%= label %></div>
      <div class="fs-4 money"><%= value %></div>
      <% if (sub) { %><div class="text-secondary small"><%= sub %></div><% } %>
    </div></div>
  <% } %>
  <%- kpi('Gross sales', money(kpis.grossCents), 'Confirmed in selected range' + (kpis.grossDeltaPct === null ? '' : ' · ' + (kpis.grossDeltaPct >= 0 ? '▲ ' : '▼ ') + Math.abs(kpis.grossDeltaPct) + '% vs prior range')) %>
  <%- kpi('Net sales after refunds', money(kpis.netCents), 'Confirmed in selected range') %>
  <%- kpi('Average order', money(kpis.aovCents), kpis.confirmedCount + ' confirmed in range') %>
  <%- kpi('Refund rate', kpis.refundRatePct + '%', money(kpis.refundedCents) + ' refunded for these sales') %>
</div>

<div class="row g-4 mb-4 align-items-stretch">
  <div class="col-12 col-lg-6">
    <div class="panel h-100">
      <p class="caption-label mb-2">Daily net revenue · sales confirmation date</p>
      <%# Bars only (the overlaid line read as noise, #6); right-side $ scale and
          a "Days" x-axis caption so the chart is readable on its own. %>
      <%- barChart(dailyRevenue.map(function (c) { return c / 100; }), { scale: true, yUnit: '$', xLabel: 'Days (oldest → newest)' }) %>
      <p class="text-secondary small mb-0 mt-1">Net <%= money(kpis.netCents) %> from sales confirmed in the selected <%= rangeDays %>-day range; all refunds against those sales are included.</p>
      <details class="small mt-2"><summary>View daily values</summary>
        <div class="table-responsive mt-2"><table class="table table-sm mb-0"><caption class="visually-hidden">Net sales by confirmation date</caption><thead><tr><th scope="col">Confirmation date</th><th scope="col" class="text-end">Net sales</th></tr></thead><tbody>
          <% dailyRevenue.forEach(function (amount, i) { %><tr><th scope="row"><%= dailyLabels[i] %></th><td class="text-end money"><%= money(amount) %></td></tr><% }); %>
        </tbody></table></div>
      </details>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="panel h-100">
      <p class="caption-label mb-2">Payment funnel</p>
      <%- funnel(paymentFunnel.stages) %>
      <details class="small mt-2"><summary>View funnel counts</summary>
        <div class="table-responsive mt-2"><table class="table table-sm mb-0"><caption class="visually-hidden">Payment funnel stage counts</caption><thead><tr><th scope="col">Stage</th><th scope="col" class="text-end">Count</th></tr></thead><tbody>
          <% paymentFunnel.stages.forEach(function (stage) { %><tr><th scope="row"><%= stage.label %></th><td class="text-end"><%= stage.count %></td></tr><% }); %>
        </tbody></table></div>
      </details>
      <p class="text-secondary small mb-0 mt-2">
        <% paymentFunnel.conversions.forEach(function (pct, i) { %><% if (i > 0) { %> · <% } %><%= paymentFunnel.stages[i].label %>→<%= paymentFunnel.stages[i + 1].label %> <%= pct %>%<% }); %>
      </p>
      <p class="text-secondary small mb-0 mt-2">
        Lost: <%= money(paymentFunnel.lostExpiredCents) %> abandoned · <%= money(paymentFunnel.lostFailedCents) %> declined.
      </p>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-7">
    <h2 class="h5 mb-2">Events · lifetime</h2>
    <% if (perEvent.length === 0) { %><p class="text-secondary">No events yet.</p><% } else { %>
    <%# CSP-safe client-side status filter (#16). Checkboxes for the statuses that
        actually appear; all checked by default so with JS off every row shows.
        app.js delegates on #event-status-filter / the events table after this
        fragment re-renders on an HTMX range swap. %>
    <% var _statuses = []; perEvent.forEach(function (e) { if (_statuses.indexOf(e.status) === -1) _statuses.push(e.status); });
       _statuses = ['OPEN', 'CLOSED', 'FULL', 'CANCELLED'].filter(function (s) { return _statuses.indexOf(s) !== -1; }); %>
    <% if (_statuses.length > 1) { %>
    <div id="event-status-filter" class="d-flex flex-wrap gap-3 mb-2 small" data-events-table="events-table">
      <% _statuses.forEach(function (s) { %>
      <label class="d-inline-flex align-items-center gap-1 mb-0">
        <input type="checkbox" class="form-check-input mt-0" data-status-filter value="<%= s %>" checked> <%= s %>
      </label>
      <% }); %>
    </div>
    <% } %>
    <div class="table-responsive"><table class="table align-middle" id="events-table">
      <thead><tr><th>Event</th><th>Status</th><th class="text-end">Fill</th><th class="text-end">Gross</th><th class="text-end">Refund %</th></tr></thead>
      <tbody><% perEvent.forEach(function (e) {
        var fill = e.total_capacity > 0 ? Math.round((e.confirmed_count / e.total_capacity) * 100) : 0;
        var rr = e.gross > 0 ? Math.round((e.refunded / e.gross) * 1000) / 10 : 0; %>
        <tr data-status="<%= e.status %>">
          <td><a class="text-decoration-none" href="/admin/events/<%= e.event_id %>/performance"><%= e.name %></a></td>
          <td><%- include('../../partials/status-pill', { status: e.status }) %></td>
          <td class="text-end"><%= fill %>%</td>
          <td class="text-end money"><%= money(e.gross) %></td>
          <td class="text-end"><%= rr %>%</td>
        </tr>
      <% }); %></tbody>
    </table></div>
    <% } %>
  </div>
  <div class="col-12 col-lg-5">
    <h2 class="h5 mb-2">Customers · lifetime</h2>
    <div class="panel mb-3">
      <div class="d-flex justify-content-between"><span class="text-secondary">New buyers</span><span><%= customers.newBuyers %></span></div>
      <div class="d-flex justify-content-between"><span class="text-secondary">Returning</span><span><%= customers.returningBuyers %> (<%= customers.repeatRatePct %>%)</span></div>
      <div class="d-flex justify-content-between"><span class="text-secondary">Activated buyers (shadow→active)</span><span><%= customers.activationRatePct %>%</span></div>
    </div>
    <% if (customers.top.length > 0) { %>
    <p class="caption-label mb-1">Top customers · lifetime net after refunds</p>
    <ul class="list-unstyled mb-0">
      <% customers.top.forEach(function (t) { %><li class="d-flex justify-content-between"><span class="small"><%= t.email %></span><span class="money small"><%= money(t.lifetime_net) %></span></li><% }); %>
    </ul>
    <% } %>
  </div>
</div>
