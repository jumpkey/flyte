<%# Swappable users table + sortable headers + pagination (HTMX target #users-table).
    Locals: users, page, totalPages, total, filters, sort. %>
<%
  function baseParams() {
    var q = new URLSearchParams();
    if (filters.q) q.set('q', filters.q);
    if (filters.status) q.set('status', filters.status);
    if (filters.locked) q.set('locked', filters.locked);
    return q;
  }
  function pageUrl(p) {
    var q = baseParams();
    q.set('sort', sort.key);
    q.set('dir', sort.dir.toLowerCase());
    q.set('page', String(p));
    return '/admin/users?' + q.toString();
  }
  // Clicking a header toggles its direction (ASC ⇄ DESC); a new column starts ASC.
  function sortUrl(key) {
    var q = baseParams();
    var nextDir = (sort.key === key && sort.dir === 'ASC') ? 'desc' : 'asc';
    q.set('sort', key);
    q.set('dir', nextDir);
    return '/admin/users?' + q.toString();
  }
  function indicator(key) {
    if (sort.key !== key) return '';
    return sort.dir === 'ASC' ? ' ▲' : ' ▼';
  }
%>
<p class="text-secondary small mb-2"><%= total %> user<%= total === 1 ? '' : 's' %></p>
<% if (!users || users.length === 0) { %>
  <%- include('../../partials/empty-state', { title: 'No users match', message: 'Try a different search.' }) %>
<% } else { %>
<div class="table-responsive">
  <table class="table align-middle">
    <thead>
      <tr>
        <th><a class="text-decoration-none" href="<%= sortUrl('email') %>" hx-get="<%= sortUrl('email') %>" hx-target="#users-table" hx-swap="innerHTML" hx-push-url="true">Email<%= indicator('email') %></a></th>
        <th><a class="text-decoration-none" href="<%= sortUrl('name') %>" hx-get="<%= sortUrl('name') %>" hx-target="#users-table" hx-swap="innerHTML" hx-push-url="true">Name<%= indicator('name') %></a></th>
        <th>Account</th>
        <th>Locked</th>
        <th class="text-end"><a class="text-decoration-none" href="<%= sortUrl('registrations') %>" hx-get="<%= sortUrl('registrations') %>" hx-target="#users-table" hx-swap="innerHTML" hx-push-url="true">Registrations<%= indicator('registrations') %></a></th>
        <th><a class="text-decoration-none" href="<%= sortUrl('joined') %>" hx-get="<%= sortUrl('joined') %>" hx-target="#users-table" hx-swap="innerHTML" hx-push-url="true">Joined<%= indicator('joined') %></a></th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function (u) { %>
      <tr class="admin-row" data-href="/admin/users/<%= u.id %>">
        <td><a class="text-decoration-none fw-semibold" href="/admin/users/<%= u.id %>"><%= u.email %></a><% if (u.is_admin) { %> <span class="pill pill-info">admin</span><% } %></td>
        <td><%= u.display_name %></td>
        <td><%- include('../../partials/status-pill', { status: u.account_status }) %></td>
        <td><% if (u.is_locked) { %><%- include('../../partials/status-pill', { status: 'LOCKED' }) %><% } else { %><span class="text-secondary">—</span><% } %></td>
        <td class="text-end"><%= u.registration_count %></td>
        <td><%= dateLong(u.created_at) %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
<nav class="d-flex justify-content-between align-items-center mt-3" aria-label="User pages">
  <% if (page > 1) { %>
    <a class="btn btn-outline-secondary btn-sm" href="<%= pageUrl(page - 1) %>" hx-get="<%= pageUrl(page - 1) %>" hx-target="#users-table" hx-swap="innerHTML" hx-push-url="true">← Previous</a>
  <% } else { %><span class="btn btn-outline-secondary btn-sm disabled">← Previous</span><% } %>
  <span class="text-secondary small">Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
    <a class="btn btn-outline-secondary btn-sm" href="<%= pageUrl(page + 1) %>" hx-get="<%= pageUrl(page + 1) %>" hx-target="#users-table" hx-swap="innerHTML" hx-push-url="true">Next →</a>
  <% } else { %><span class="btn btn-outline-secondary btn-sm disabled">Next →</span><% } %>
</nav>
<% } %>
<% } %>
