<h1 class="h3 mb-4">Users</h1>

<form class="row g-2 align-items-end mb-4" method="get" action="/admin/users"
      hx-get="/admin/users" hx-target="#users-table" hx-swap="innerHTML" hx-push-url="true">
  <div class="col-12 col-md-5">
    <label class="form-label" for="q">Search</label>
    <input class="form-control" type="search" id="q" name="q" value="<%= filters.q %>" placeholder="Email or name">
  </div>
  <div class="col-6 col-md-3">
    <label class="form-label" for="status">Account</label>
    <select class="form-select" id="status" name="status">
      <option value="">All</option>
      <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="shadow" <%= filters.status === 'shadow' ? 'selected' : '' %>>Shadow</option>
    </select>
  </div>
  <div class="col-6 col-md-2">
    <label class="form-label" for="locked">Locked</label>
    <select class="form-select" id="locked" name="locked">
      <option value="">Any</option>
      <option value="true" <%= filters.locked === 'true' ? 'selected' : '' %>>Locked</option>
      <option value="false" <%= filters.locked === 'false' ? 'selected' : '' %>>Unlocked</option>
    </select>
  </div>
  <div class="col-12 col-md-2 d-flex gap-2">
    <button class="btn btn-primary" type="submit">Filter</button>
    <a class="btn btn-outline-secondary" href="/admin/users">Reset</a>
  </div>
</form>

<div id="users-table">
  <%- include('partials/users-table', { users: users, page: page, totalPages: totalPages, total: total, filters: filters, sort: sort }) %>
</div>
