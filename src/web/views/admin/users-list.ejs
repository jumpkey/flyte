<h1 class="h3 mb-4">Users</h1>

<form class="row g-2 align-items-end mb-4" method="get" action="/admin/users">
  <div class="col-12 col-md-5">
    <label class="form-label" for="q">Search</label>
    <input class="form-control" type="search" id="q" name="q" value="<%= filters.q %>" placeholder="Email or name">
  </div>
  <div class="col-6 col-md-3">
    <label class="form-label" for="status">Account</label>
    <select class="form-select" id="status" name="status">
      <option value="">All</option>
      <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="shadow" <%= filters.status === 'shadow' ? 'selected' : '' %>>Shadow</option>
    </select>
  </div>
  <div class="col-6 col-md-2">
    <label class="form-label" for="locked">Locked</label>
    <select class="form-select" id="locked" name="locked">
      <option value="">Any</option>
      <option value="true" <%= filters.locked === 'true' ? 'selected' : '' %>>Locked</option>
      <option value="false" <%= filters.locked === 'false' ? 'selected' : '' %>>Unlocked</option>
    </select>
  </div>
  <div class="col-12 col-md-2 d-flex gap-2">
    <button class="btn btn-primary" type="submit">Filter</button>
    <a class="btn btn-outline-secondary" href="/admin/users">Reset</a>
  </div>
</form>

<% if (!users || users.length === 0) { %>
  <%- include('../partials/empty-state', { title: 'No users match', message: 'Try a different search.' }) %>
<% } else { %>
<div class="table-responsive">
  <table class="table align-middle">
    <thead><tr><th>Email</th><th>Name</th><th>Account</th><th>Locked</th><th class="text-end">Registrations</th><th>Joined</th></tr></thead>
    <tbody>
      <% users.forEach(function (u) { %>
      <tr class="admin-row" data-href="/admin/users/<%= u.id %>">
        <td><a class="text-decoration-none fw-semibold" href="/admin/users/<%= u.id %>"><%= u.email %></a><% if (u.is_admin) { %> <span class="pill pill-info">admin</span><% } %></td>
        <td><%= u.display_name %></td>
        <td><%- include('../partials/status-pill', { status: u.account_status }) %></td>
        <td><% if (u.is_locked) { %><%- include('../partials/status-pill', { status: 'LOCKED' }) %><% } else { %><span class="text-secondary">—</span><% } %></td>
        <td class="text-end"><%= u.registration_count %></td>
        <td><%= dateLong(u.created_at) %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>
