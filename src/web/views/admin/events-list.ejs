<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Events</h1>
  <a class="btn btn-primary" href="/admin/events/new">+ New event</a>
</div>

<% if (!events || events.length === 0) { %>
  <%- include('../partials/empty-state', { title: 'No events yet', message: 'Create your first event to start taking registrations.', ctaHref: '/admin/events/new', ctaLabel: 'New event' }) %>
<% } else { %>
<div class="table-responsive">
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Name</th><th>Date</th><th>Status</th>
        <th class="text-end">Confirmed</th><th class="text-end">Available</th><th class="text-end">Revenue</th>
      </tr>
    </thead>
    <tbody>
      <% events.forEach(function (ev) { %>
      <tr role="button" onclick="" data-href="/admin/events/<%= ev.event_id %>" class="admin-row">
        <td><a class="text-decoration-none fw-semibold" href="/admin/events/<%= ev.event_id %>"><%= ev.name %></a></td>
        <td><%= dateLong(ev.event_date) %></td>
        <td><%- include('../partials/status-pill', { status: ev.status }) %></td>
        <td class="text-end money"><%= ev.confirmed_count %> / <%= ev.total_capacity %></td>
        <td class="text-end money"><%= ev.available_slots %></td>
        <td class="text-end money"><%= money(ev.gross_revenue_cents || 0) %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>
