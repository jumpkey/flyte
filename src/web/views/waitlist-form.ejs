<div class="container py-4">
  <div class="panel checkout-panel">
    <h1 class="h3 mb-1">Join the waitlist</h1>
    <p class="text-muted mb-3"><%= event.name %></p>

    <% if (typeof reason !== 'undefined' && reason === 'full') { %>
    <div class="alert alert-flyte alert-flyte-error" role="alert">
      This event just sold out. Join the waitlist and we'll contact you if a spot opens up.
    </div>
    <% } %>

    <p class="text-muted">No spots are currently available. No payment is required to join the waitlist.</p>

    <form method="POST" action="/events/<%= event.eventId %>/waitlist">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6">
          <label class="form-label" for="firstName">First name</label>
          <input class="form-control" type="text" id="firstName" name="firstName" required>
        </div>
        <div class="col-12 col-sm-6">
          <label class="form-label" for="lastName">Last name</label>
          <input class="form-control" type="text" id="lastName" name="lastName" required>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" required>
      </div>
      <div class="mb-4">
        <label class="form-label" for="phone">Phone (optional)</label>
        <input class="form-control" type="tel" id="phone" name="phone">
      </div>
      <button type="submit" class="btn btn-primary w-100">Join waitlist</button>
    </form>
  </div>
</div>
