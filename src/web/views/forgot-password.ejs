<div class="container">
  <div class="panel auth-panel">
    <% if (typeof activate !== 'undefined' && activate) { %>
    <h1 class="h3 mb-1">Activate your account</h1>
    <p class="text-muted mb-4">Set a password to claim your guest registrations. We'll email you a link to finish.</p>
    <% } else { %>
    <h1 class="h3 mb-1">Forgot password</h1>
    <p class="text-muted mb-4">Enter your email and we'll send you a reset link.</p>
    <% } %>
    <form action="/forgot-password" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" required autocomplete="email" value="<%= typeof email !== 'undefined' ? email : '' %>">
      </div>
      <button type="submit" class="btn btn-primary w-100">Send reset link</button>
    </form>
    <p class="mt-4 mb-0 text-center"><a href="/login">Back to sign in</a></p>
  </div>
</div>
