<div class="container py-4">
  <div class="panel checkout-panel text-center">
    <h1 class="h3 mb-3">Payment failed</h1>
    <div class="alert alert-flyte alert-flyte-error text-start" role="alert">
      We couldn't process your payment. This is usually insufficient funds, a bank decline, or mistyped card details.
    </div>
    <p class="text-muted">Try again with a different payment method, or contact your bank for details. Your spot was released — re-register to try again.</p>
    <button type="button" class="btn btn-primary mt-2" data-back>Try again</button>
    <a href="/" class="btn btn-outline-secondary mt-2">Return home</a>
  </div>
</div>
